{
  "name": "shelf-capture-mvp",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "test": "npm run test:guidance && npm run test:upload && npm run test:recognition && npm run test:capture-ui",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:guidance": "node --experimental-strip-types --test tests/captureGuidance.test.mjs",
    "test:upload": "node --experimental-strip-types --test tests/uploadContract.test.mjs",
    "test:recognition": "node --experimental-strip-types --test tests/recognitionDisplay.test.mjs",
    "test:capture-ui": "node --experimental-strip-types --test tests/captureWorkflow.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notchip/expo-panoramic-stitcher": "0.7.0",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-media-library": "~57.0.5",
    "expo-screen-orientation": "~57.0.2",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
